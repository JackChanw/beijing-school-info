---
import BaseLayout from '../../layouts/BaseLayout.astro';
import SchoolCard from '../../components/SchoolCard.astro';
import { schools } from '../../data/schools';
import type { District } from '../../types/school';

// 按区域分组
const byDistrict = schools.reduce<Record<string, typeof schools>>((acc, school) => {
  const d = school.district;
  if (!acc[d]) acc[d] = [];
  acc[d].push(school);
  return acc;
}, {});

const districts = Object.keys(byDistrict).sort() as District[];
---

<BaseLayout title="学校列表" description="浏览北京各区所有收录学校，按行政区分组展示。">
  <div class="max-w-6xl mx-auto px-4 py-10">
    <h1 class="text-3xl font-bold text-gray-900 mb-2">学校列表</h1>
    <p class="text-gray-500 mb-8">共收录 {schools.length} 所学校，覆盖 {districts.length} 个行政区</p>

    <!-- 区域锚点快速跳转 -->
    <div class="flex flex-wrap gap-2 mb-10">
      {districts.map((d) => (
        <a
          href={`#district-${d}`}
          class="text-sm bg-[#C8102E]/10 text-[#C8102E] px-3 py-1 rounded-full hover:bg-[#C8102E]/20 transition-colors"
        >
          {d}（{byDistrict[d].length}）
        </a>
      ))}
    </div>

    <!-- 按区域展示 -->
    {districts.map((district) => (
      <section id={`district-${district}`} class="mb-12 scroll-mt-20">
        <h2 class="text-xl font-bold text-gray-800 mb-5 flex items-center gap-2">
          <span class="w-1 h-6 bg-[#C8102E] rounded-full inline-block"></span>
          {district}
        </h2>
        <div class="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-3 gap-5">
          {byDistrict[district].map((school) => (
            <SchoolCard school={school} />
          ))}
        </div>
      </section>
    ))}
  </div>
</BaseLayout>

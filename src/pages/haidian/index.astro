---
import BaseLayout from '../../layouts/BaseLayout.astro';
import { haidianGroups } from '../../data/haidian';
---

<BaseLayout title="海淀区幼升小政策" description="海淀区2026年幼升小入学政策，按北京户籍、工作居住证、居住证、无证件分类展示入学条件和材料清单。">
  <!-- 页头 -->
  <section class="bg-blue-700 text-white py-10 px-4">
    <div class="max-w-4xl mx-auto">
      <p class="text-blue-200 text-sm mb-1"><a href="/" class="hover:underline">首页</a> / 海淀区</p>
      <h1 class="text-2xl md:text-3xl font-extrabold mb-2">海淀区 2026 年幼升小政策</h1>
      <p class="text-blue-100 text-sm">来源：海淀区教育委员会，2026年4月28日发布 · 现行有效</p>
    </div>
  </section>

  <!-- 关键时间轴 -->
  <section class="max-w-4xl mx-auto px-4 py-8">
    <h2 class="text-lg font-bold text-gray-800 mb-4">报名时间节点</h2>
    <div class="overflow-x-auto">
      <table class="w-full text-sm border-collapse">
        <thead>
          <tr class="bg-gray-100 text-left">
            <th class="px-4 py-2 font-semibold text-gray-700 rounded-tl-lg">时间</th>
            <th class="px-4 py-2 font-semibold text-gray-700 rounded-tr-lg">事项</th>
          </tr>
        </thead>
        <tbody class="divide-y divide-gray-100">
          {[
            ['5月1日起', '开通义务教育入学服务平台（yjrx.bjedu.cn）'],
            ['5月6日—31日', '本市户籍适龄儿童信息采集'],
            ['5月6日—15日', '非京籍适龄儿童信息注册'],
            ['5月11日—15日', '相关部门网上初审'],
            ['5月18日—29日', '各街镇及相关部门联合审核材料'],
            ['6月5日—6日', '民办小学、公办中学举办小学部报名'],
            ['6月11日前', '民办小学等派位录取'],
            ['6月13日—14日', '小学登记，审核入学材料'],
            ['6月22日—23日', '2019年后购房业主子女填报志愿'],
            ['6月30日', '2019年后购房业主子女电脑派位'],
            ['7月上旬', '发放新生入学通知书'],
          ].map(([time, event]) => (
            <tr class="hover:bg-gray-50">
              <td class="px-4 py-2.5 text-gray-500 whitespace-nowrap">{time}</td>
              <td class="px-4 py-2.5 text-gray-800">{event}</td>
            </tr>
          ))}
        </tbody>
      </table>
    </div>
    <p class="text-xs text-gray-400 mt-2">咨询电话：010-62819952（工作日 8:30—11:30，13:30—17:00）</p>
  </section>

  <!-- 海淀特有政策说明 -->
  <section class="max-w-4xl mx-auto px-4 pb-6">
    <div class="bg-blue-50 border border-blue-200 rounded-xl p-4 text-sm text-blue-800">
      <strong>海淀区特别政策：</strong>
      <ul class="mt-2 space-y-1 list-disc list-inside">
        <li>六年一学位：同一住房6年内原则上只提供一个登记入学学位（多孩除外）</li>
        <li>2019年1月1日后新登记取证的住房，采用电脑派位多校划片入学</li>
        <li>2022年1月1日后迁入海淀户籍的儿童，不对应划片学校，在区内协调解决</li>
      </ul>
    </div>
  </section>

  <!-- 人群选择卡片 -->
  <section class="max-w-4xl mx-auto px-4 pb-10">
    <h2 class="text-lg font-bold text-gray-800 mb-4">选择你的户籍类型，查看专属政策</h2>
    <div class="grid grid-cols-1 sm:grid-cols-2 gap-4">
      {haidianGroups.map(g => (
        <a href={`/haidian/${g.slug}`}
           class="block bg-white rounded-xl border border-gray-100 hover:border-blue-400/40 hover:shadow-md transition-all p-5">
          <div class="flex items-center justify-between mb-2">
            <span class={`text-xs font-medium px-2 py-1 rounded-full ${g.tagColor}`}>{g.label}</span>
            <span class="text-xs text-gray-400">优先级 {g.priority}</span>
          </div>
          <p class="text-sm font-semibold text-gray-800 mb-1">{g.priorityLabel}</p>
          <p class="text-xs text-gray-500">{g.conditions[0]?.items[0]}</p>
          <p class="mt-3 text-xs text-blue-600 font-medium">查看条件与材料清单 →</p>
        </a>
      ))}
    </div>
  </section>
</BaseLayout>

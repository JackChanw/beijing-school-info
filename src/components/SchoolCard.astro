---
import type { School } from '../types/school';

interface Props {
  school: School;
}

const { school } = Astro.props;

const typeColors: Record<string, string> = {
  '小学': 'bg-green-100 text-green-800',
  '初中': 'bg-blue-100 text-blue-800',
  '高中': 'bg-purple-100 text-purple-800',
  '九年一贯制': 'bg-teal-100 text-teal-800',
  '完全中学': 'bg-orange-100 text-orange-800',
  '十二年一贯制': 'bg-pink-100 text-pink-800',
};

const tagColor = typeColors[school.type] ?? 'bg-gray-100 text-gray-800';
---

<a
  href={`/schools/${school.slug}`}
  class="block bg-white rounded-xl shadow-sm hover:shadow-md transition-shadow duration-200 overflow-hidden border border-gray-100 hover:border-[#C8102E]/20"
>
  <!-- 顶部色条 -->
  <div class="h-1.5 bg-[#C8102E]"></div>
  <div class="p-5">
    <div class="flex items-start justify-between gap-3 mb-3">
      <h3 class="font-bold text-gray-900 text-lg leading-snug">{school.name}</h3>
      <span class={`shrink-0 text-xs font-medium px-2 py-1 rounded-full ${tagColor}`}>
        {school.type}
      </span>
    </div>
    <p class="text-sm text-gray-500 mb-1">📍 {school.district} · 创建于 {school.founded} 年</p>
    <p class="text-sm text-gray-600 line-clamp-2 mb-4">{school.description}</p>
    <div class="flex flex-wrap gap-1.5">
      {school.highlights.slice(0, 3).map((h) => (
        <span class="text-xs bg-gray-100 text-gray-600 px-2 py-0.5 rounded">{h}</span>
      ))}
    </div>
  </div>
</a>
